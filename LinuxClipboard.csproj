<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>2.0.1</Version>
		<Authors>jukefr</Authors>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<!-- ResonitePath is optional for CI/build: if it isn't provided, we will populate it with
	     stub output from the BuildStubs target above. -->
	<PropertyGroup Condition="'$(ResonitePath)' == ''">
		<!-- default windows and linux paths, manual fallback if both don't turn up anything -->
		<ResonitePath Condition="'$(OS)' == 'Windows_NT' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Resonite')">C:/Program Files (x86)/Steam/steamapps/common/Resonite</ResonitePath>

		<ResonitePath Condition="'$(OS)' != 'Windows_NT' and Exists('$(HOME)/.steam/steam/steamapps/common/Resonite')">$(HOME)/.steam/steam/steamapps/common/Resonite</ResonitePath>
	</PropertyGroup>

	<!-- path containing managed dlls. for post-split, this is the same as resonite path, but still here just in case -->
	<PropertyGroup>
		<ManagedPath>$(ResonitePath)</ManagedPath>
	</PropertyGroup>

	<ItemGroup>
		<ResoniteReference Include="Elements.Assets"/>
		<ResoniteReference Include="Renderite.Host"/>
			
		<Reference Include="ResoniteModLoader">
			<HintPath>$(ResonitePath)/Libraries/ResoniteModLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="HarmonyLib">
			<HintPath>$(ResonitePath)/rml_libs/0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!--
	  CI friendliness:
	  Ensure stub assemblies exist so the action can run just `dotnet build LinuxClipboard.csproj`.
	  This avoids relying on downloaded/prebuilt stub artifacts.
	-->
	<Target Name="BuildStubs" BeforeTargets="PrepareForBuild">
		<!--
		  Build required stub assemblies into stubs/prebuilt so the rest of this project
		  can reference them without depending on ResonitePath.
		-->
		<PropertyGroup>
			<_StubOutDir>$(MSBuildProjectDirectory)/stubs/prebuilt</_StubOutDir>
			<!-- Make ResonitePath point at our stub output so HintPaths resolve. -->
			<ResonitePath Condition="'$(ResonitePath)' == ''">$(_StubOutDir)</ResonitePath>
		</PropertyGroup>
		<MakeDir Directories="$(_StubOutDir)" />
		<Exec Command='dotnet build "stubs/Elements.Assets/Elements.Assets.csproj" -c $(Configuration) -o "$(_StubOutDir)"' />
		<Exec Command='dotnet build "stubs/Renderite.Host/Renderite.Host.csproj" -c $(Configuration) -o "$(_StubOutDir)"' />
	</Target>

	<ItemGroup>
		<Reference Include="@(ResoniteReference)">
			<Name>%(ResoniteReference.Identity)</Name>
			<!-- For CI (and general determinism), prefer the locally built stub assemblies. -->
			<HintPath Condition="'%(HintPath)' == '' And Exists('$(MSBuildProjectDirectory)/stubs/prebuilt/%(Identity).dll')">$(MSBuildProjectDirectory)/stubs/prebuilt/%(Identity).dll</HintPath>
			<HintPath Condition="'%(HintPath)' == '' And Exists('$(MSBuildProjectDirectory)/stubs/prebuilt/%(Identity).exe')">$(MSBuildProjectDirectory)/stubs/prebuilt/%(Identity).exe</HintPath>
			<!-- Fallback to real Resonite managed binaries when ResonitePath is present. -->
			<HintPath Condition="'%(HintPath)' == '' And Exists('$(ManagedPath)/%(Identity).dll')">$(ManagedPath)/%(Identity).dll</HintPath>
			<HintPath Condition="'%(HintPath)' == '' And Exists('$(ManagedPath)/%(Identity).exe')">$(ManagedPath)/%(Identity).exe</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' and Exists('$(ResonitePath)/rml_libs/ResoniteHotReloadLib.dll')">
		<Reference Include="ResoniteHotReloadLib">
			<HintPath>$(ResonitePath)/rml_libs/ResoniteHotReloadLib.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="LinuxClipboard.Core/LinuxClipboard.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="LinuxClipboard.cs" />
	</ItemGroup>

	<Target Name="Copy" DependsOnTargets="Build">
		<Message Text="Copying $(TargetFileName) to $(ResonitePath)/rml_mods" Importance="High" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResonitePath)/rml_mods" />
		<Message Condition="'$(Configuration)' == 'Debug'" Text="Debug build, copying $(TargetFileName) to $(ResonitePath)/rml_mods/HotReloadMods" Importance="High" />
		<Copy Condition="'$(Configuration)' == 'Debug'" SourceFiles="$(TargetPath)" DestinationFolder="$(ResonitePath)/rml_mods/HotReloadMods" />
		<Delete Condition="'$(Configuration)' == 'Release'" Files="$(ResonitePath)/rml_mods/HotReloadMods/$(AssemblyName).dll" />
	</Target>

</Project>
